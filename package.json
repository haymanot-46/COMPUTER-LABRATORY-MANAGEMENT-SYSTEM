{
  "name": "clms-monorepo",
  "version": "2.0.0",
  "description": "CLMS - Computer Laboratory Management System",
  "private": true,
  "scripts": {
    "dev:backend": "cd backend && node src/server-final.js",
    "dev:frontend": "cd frontend && npx vite --port 5175",
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "start:backend": "cd backend && node src/server-final.js",
    "build:frontend": "cd frontend && npx vite build"
  },
  "dependencies": {
    "concurrently": "^8.2.2"
  }
}
