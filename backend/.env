# backend/.env
# ============================================
# SERVER CONFIGURATION
# ============================================
PORT=5001
NODE_ENV=development
API_URL=http://localhost:5001
FRONTEND_URL=http://localhost:5175

# ============================================
# DATABASE CONFIGURATION (MAMP)
# ============================================
DB_HOST=localhost
DB_PORT=3306
DB_NAME=clms_db
DB_USER=haymanot
DB_PASSWORD=haymanot

# ============================================
# JWT AUTHENTICATION
# ============================================
JWT_SECRET=my_super_secret_key_12345_clms_project_2025
JWT_EXPIRE=30d
JWT_REFRESH_EXPIRE=60d

# ============================================
# EMAIL CONFIGURATION (Gmail/SMTP)
# ============================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=haymanotebabu2@gmail.com
SMTP_PASS=llzlxbwqypcndedx
SMTP_FROM=CLMS <admin@clms.com>
SMTP_FROM="CLMS Support" <haymanotebabu2@gmail.com>
# ============================================
# REDIS CONFIGURATION (For Caching & Queues)
# ============================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ============================================
# S3/MinIO CONFIGURATION (File Storage)
# ============================================
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=clms-uploads
S3_REGION=us-east-1
S3_USE_SSL=false

# ============================================
# SMS CONFIGURATION (Ethio Telecom)
# ============================================
SMS_API_KEY=your_sms_api_key
SMS_SENDER=CLMS
SMS_API_URL=https://api.ethiotelecom.et/sms
SMS_TIMEOUT=10000

# ============================================
# FILE UPLOAD CONFIGURATION
# ============================================
MAX_FILE_SIZE_MB=20
MAX_FILE_SIZE_BYTES=20971520
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/jpg,application/pdf,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document

# ============================================
# RATE LIMITING
# ============================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# ============================================
# LOGGING
# ============================================
LOG_LEVEL=info
LOG_DIR=./logs

# ============================================
# BACKUP CONFIGURATION
# ============================================
BACKUP_PATH=./backups
BACKUP_RETENTION_DAYS=30
BACKUP_SCHEDULE=0 0 2 * * *

# ============================================
# FEATURE FLAGS
# ============================================
ENABLE_EMAIL_NOTIFICATIONS=true
ENABLE_SMS_NOTIFICATIONS=false
ENABLE_WEBSOCKET=false
ENABLE_CACHE=true
ENABLE_FILE_UPLOADS=true
ENABLE_BACKUP=true

# ============================================
# SESSION CONFIGURATION
# ============================================
SESSION_TIMEOUT_MINUTES=60
MAX_LOGIN_ATTEMPTS=5
ACCOUNT_LOCKOUT_MINUTES=30

# ============================================
# PAGINATION DEFAULTS
# ============================================
DEFAULT_PAGE_SIZE=10
MAX_PAGE_SIZE=100

# ============================================
# CORS CONFIGURATION
# ============================================
CORS_ORIGIN=http://localhost:5175,http://localhost:3000
CORS_CREDENTIALS=true

# ============================================
# SECURITY
# ============================================
BCRYPT_ROUNDS=10
PASSWORD_MIN_LENGTH=6
TOKEN_EXPIRY_MINUTES=1440

# ============================================
# TIMEZONE (Ethiopia)
# ============================================
TZ=Africa/Addis_Ababa
TIMEZONE_OFFSET=+03:00

# ============================================
# MAINTENANCE MODE
# ============================================
MAINTENANCE_MODE=false
MAINTENANCE_MESSAGE=System under maintenance. Please check back later.

# ============================================
# DEMO MODE
# ============================================
DEMO_MODE=false
DEMO_EMAIL=demo@clms.com
DEMO_PASSWORD=demo123