# backend/.env

# ============================================
# SERVER CONFIGURATION
# ============================================
PORT=5000
NODE_ENV=development
API_URL=http://localhost:5000
FRONTEND_URL=http://localhost:5173

# ============================================
# DATABASE CONFIGURATION (MAMP)
# ============================================
DB_HOST=localhost
DB_PORT=3306
DB_NAME=clms_db
DB_USER=root
DB_PASSWORD=root

# ============================================
# JWT AUTHENTICATION
# ============================================
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRE=30d
JWT_REFRESH_EXPIRE=60d

# ============================================
# ADMIN DEFAULT USER (Only for initial setup)
# ============================================
ADMIN_EMAIL=admin@clms.com
ADMIN_PASSWORD=admin123
ADMIN_FIRST_NAME=System
ADMIN_LAST_NAME=Administrator

# ============================================
# EMAIL CONFIGURATION (For ALL users)
# ============================================
# For development/testing (no real email needed)
# Set ENABLE_EMAIL=false to disable email sending
ENABLE_EMAIL=true

# Gmail SMTP (for sending emails to all users)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_clms_email@gmail.com
SMTP_PASS=your_16_digit_app_password
SMTP_FROM=CLMS System <noreply@clms.com>

# Alternative: Using Ethereal Email (for testing only)
# SMTP_HOST=smtp.ethereal.email
# SMTP_PORT=587
# SMTP_USER=your_ethereal_username
# SMTP_PASS=your_ethereal_password

# Alternative: Using SendGrid
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_USER=apikey
# SMTP_PASS=your_sendgrid_api_key

# Email templates
WELCOME_EMAIL_ENABLED=true
PASSWORD_RESET_EMAIL_ENABLED=true
ATTENDANCE_SUMMARY_EMAIL_ENABLED=true
SCHEDULE_REMINDER_EMAIL_ENABLED=true
MAINTENANCE_EMAIL_ENABLED=true

# ============================================
# SMS CONFIGURATION (Ethio Telecom)
# ============================================
# For development/testing (no real SMS)
ENABLE_SMS=false  # Set to true only when ready

# Ethio Telecom SMS API (Production)
SMS_API_KEY=your_sms_api_key_from_ethio_telecom
SMS_SENDER=CLMS
SMS_API_URL=https://api.ethiotelecom.et/sms/v1/send
SMS_API_VERSION=v1
SMS_TIMEOUT=10000

# Ethio Telecom SMS Authentication
SMS_CLIENT_ID=your_client_id
SMS_CLIENT_SECRET=your_client_secret
SMS_TOKEN_URL=https://api.ethiotelecom.et/auth/token

# SMS Templates
SMS_OTP_TEMPLATE="Your CLMS verification code is: {code}"
SMS_ATTENDANCE_TEMPLATE="CLMS: Your attendance for {course} on {date} is {status}"
SMS_REMINDER_TEMPLATE="CLMS Reminder: {course} lab at {time} in {lab}"

# Alternative SMS Providers
# Africa's Talking
# SMS_API_KEY=your_africastalking_api_key
# SMS_USERNAME=your_africastalking_username
# SMS_API_URL=https://api.africastalking.com/version1/messaging

# Twilio
# TWILIO_ACCOUNT_SID=your_account_sid
# TWILIO_AUTH_TOKEN=your_auth_token
# TWILIO_PHONE_NUMBER=+1234567890

# ============================================
# REDIS CONFIGURATION (Optional)
# ============================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
ENABLE_REDIS=false  # Set to true if Redis is installed

# ============================================
# FILE UPLOAD
# ============================================
MAX_FILE_SIZE_MB=20
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/jpg,application/pdf
UPLOAD_PATH=./uploads

# ============================================
# RATE LIMITING
# ============================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# ============================================
# BACKUP
# ============================================
BACKUP_PATH=./backups
BACKUP_RETENTION_DAYS=30
ENABLE_AUTO_BACKUP=false  # Set to true for production

# ============================================
# LOGGING
# ============================================
LOG_LEVEL=info
LOG_DIR=./logs