# ============================================
# CLMS Frontend Environment Configuration
# Template - Copy to .env and modify as needed
# ============================================

# App Configuration
VITE_APP_NAME=CLMS
VITE_APP_VERSION=2.0.0
VITE_APP_ENV=development

# API Configuration
VITE_API_URL=http://localhost:5001/api
VITE_API_TIMEOUT=30000

# WebSocket Configuration
VITE_WS_URL=ws://localhost:5001

# Feature Flags
VITE_ENABLE_OFFLINE_MODE=true
VITE_ENABLE_PWA=true
VITE_ENABLE_ANALYTICS=false
VITE_ENABLE_DEBUG_MODE=true

# Authentication
VITE_TOKEN_KEY=token
VITE_USER_KEY=user
VITE_TOKEN_EXPIRY=7d

# Pagination
VITE_DEFAULT_PAGE_SIZE=10
VITE_PAGE_SIZE_OPTIONS=5,10,25,50,100

# File Upload
VITE_MAX_FILE_SIZE=5242880  # 5MB in bytes
VITE_ALLOWED_FILE_TYPES=image/jpeg,image/png,image/jpg,application/pdf

# Date Format
VITE_DATE_FORMAT=YYYY-MM-DD
VITE_DATETIME_FORMAT=YYYY-MM-DD HH:mm:ss
VITE_TIME_FORMAT=HH:mm

# Theme
VITE_DEFAULT_THEME=light
VITE_ALLOW_THEME_SWITCH=true

# Notifications
VITE_ENABLE_NOTIFICATIONS=true
VITE_NOTIFICATION_DURATION=5000  # milliseconds

# Offline Sync
VITE_OFFLINE_SYNC_INTERVAL=30000  # milliseconds
VITE_OFFLINE_STORAGE_PREFIX=clms_

# Debug
VITE_DEBUG_API_CALLS=false
VITE_DEBUG_STATE_CHANGES=false

# Security
VITE_ENABLE_CSP=false
VITE_ENABLE_CSRF_PROTECTION=false